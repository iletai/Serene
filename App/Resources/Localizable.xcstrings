    "settings.timezone.astronomy_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The An Niên astronomical system automatically calculates Conjunction and Full Moon times and the 24 Solar Terms based on the 105th Meridian East (Hanoi, Indochina), ensuring the calendar and memorial dates are entirely accurate according to Vietnamese customs no matter where you are in the world."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống thiên văn An Niên tự động tính toán thời điểm Sóc Vọng và 24 Tiết Khí dựa trên Kinh tuyến 105° Đông (Hà Nội, Đông Dương), đảm bảo lịch ngày và ngày giỗ hoàn toàn chính xác theo phong tục Việt Nam dù bạn đang ở bất kỳ nơi nào trên thế giới."
          }
        }
      }
    },
