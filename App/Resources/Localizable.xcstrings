    "folkquote.1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When eating fruit, remember who planted the tree;\nWhen eating sweet potatoes, remember who gave the vine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ăn quả nhớ kẻ trồng cây\nĂn khoai nhớ kẻ cho dây mà trồng."
          }
        }
      }
    },
    "folkquote.2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Father's virtue is high as Mount Thai Son;\nMother's devotion flows like water from an endless spring."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cha như núi Thái Sơn\nNghĩa mẹ như nước trong nguồn chảy ra."
          }
        }
      }
    },
    "folkquote.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When husband and wife agree in harmony, even the Eastern Sea can be bailed dry."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thuận vợ thuận chồng, tát biển Đông cũng cạn."
          }
        }
      }
    },
    "folkquote.4.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kind words cost nothing to buy;\nChoose words wisely to keep mutual peace and harmony."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nói chẳng mất tiền mua\nLựa lời mà nói cho vừa lòng nhau."
          }
        }
      }
    },
    "folkquote.5.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wherever you go across the land,\nRemember the Ancestor Memorial on the 10th of the 3rd lunar month."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù ai đi ngược về xuôi\nNhớ ngày Giỗ Tổ mùng mười tháng ba."
          }
        }
      }
    },
    "folkquote.6.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gourd, love the pumpkin as your own;\nThough different varieties, you share the same trellis."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bầu ơi thương lấy bí cùng\nTuy rằng khác giống nhưng chung một giàn."
          }
        }
      }
    },
    "folkquote.7.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To cross the river, build a bridge;\nTo raise wise children, honor and love the teacher."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muốn sang thì bắc cầu Kiều\nMuốn con hay chữ thì yêu lấy thầy."
          }
        }
      }
    },
    "folkquote.8.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink water remembering the source; as children, filial piety must be kept."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống nước nhớ nguồn, làm con phải giữ đạo hiếu."
          }
        }
      }
    },
    "folkquote.9.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single tree makes no forest;\nThree trees clustered together make a lofty mountain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cây làm chẳng nên non\nBa cây chụm lại nên hòn núi cao."
          }
        }
      }
    },
    "folkquote.10.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As red silk covers the mirror frame,\nCompatriots of one land must cherish and protect one another."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhiễu điều phủ lấy giá gương\nNgười trong một nước phải thương nhau cùng."
          }
        }
      }
    },
    "folkquote.11.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brothers and sisters are like hands and feet;\nIn hardship or comfort, protect and shelter each other."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh em như thể tay chân\nRách lành đùm bọc dở hay đỡ đần."
          }
        }
      }
    },
    "folkquote.12.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An inch of earth is an inch of gold; mankind is the finest flower of the soil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tấc đất tấc vàng, người ta là hoa của đất."
          }
        }
      }
    },
    "folkquote.13.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birds have nests, humans have ancestors;\nAs trees have roots, as rivers have springs."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chim có tổ, người có tông\nNhư cây có cội, như sông có nguồn."
          }
        }
      }
    },
    "folkquote.14.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel a day's journey, gather a basket of wisdom."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đi một ngày đàng, học một sàng khôn."
          }
        }
      }
    },
    "folkquote.15.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With patience to grind the iron, one day a needle is forged."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có công mài sắt, có ngày nên kim."
          }
        }
      }
    },
    "folkquote.16.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay upright even when hungry; maintain dignity even in rags."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đói cho sạch, rách cho thơm."
          }
        }
      }
    },
    "folkquote.17.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The whole leaf shelters the torn leaf; love others as you love yourself."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lá lành đùm lá rách, thương người như thể thương thân."
          }
        }
      }
    },
    "folkquote.18.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sip tea while admiring the moon; a peaceful heart brings peace to all things."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uống trà ngắm trăng, tâm an vạn sự an."
          }
        }
      }
    },
    "folkquote.19.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spring brings birth, summer fosters growth, autumn gathers, winter preserves."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuân sinh, hạ trưởng, thu liễm, đông tàng."
          }
        }
      }
    },
    "folkquote.20.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All things follow natural destiny; let the heart stay serene and the mind bright."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vạn sự tùy duyên, tâm an dạ sáng."
          }
        }
      }
    },
    "folkquote.21.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Father's sustenance, mother's clothing, teacher's lessons;\nStrive diligently in study to attain noble standing."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơm cha áo mẹ chữ thầy\nGắng công mà học có ngày thành danh."
          }
        }
      }
    },
    "folkquote.22.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve family heritage and customs;\nThe ancestral roots shine bright across generations."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ gìn gia phong nếp nhà\nCội nguồn tiên tổ sáng soi muôn đời."
          }
        }
      }
    },
    "folkquote.23.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heaven has four seasons: Spring, Summer, Autumn, Winter;\nMan has four virtues: Diligence, Frugality, Integrity, Uprightness."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trời có bốn mùa: Xuân Hạ Thu Đông\nNgười có bốn đức: Cần Kiệm Liêm Chính."
          }
        }
      }
    },
    "folkquote.24.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jade unpolished becomes no treasure;\nMan untaught knows not the noble path."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngọc bất trác, bất thành khí\nNhân bất học, bất tri đạo."
          }
        }
      }
    },
    "folkquote.25.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Near ink one is blackened; near the lamp one is enlightened."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gần mực thì đen, gần đèn thì rạng."
          }
        }
      }
    },
    "folkquote.26.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prudent eating brings fullness; prudent thrift brings warmth."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khéo ăn thì no, khéo co thì ấm."
          }
        }
      }
    },
    "folkquote.27.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cheerful smile is worth ten doses of tonic medicine."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nụ cười bằng mười thang thuốc bổ."
          }
        }
      }
    },
    "folkquote.28.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising pigs lets you eat at ease; raising silkworms keeps you standing on your feet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuôi lợn ăn cơm nằm, nuôi tằm ăn cơm đứng."
          }
        }
      }
    },
    "folkquote.29.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birds roost in auspicious lands; family blessings endure through ages."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đất lành chim đậu, phúc trạch lưu trường."
          }
        }
      }
    },
    "folkquote.30.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mastering one craft brings lifelong honor and dignity."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhất nghệ tinh, nhất thân vinh."
          }
        }
      }
    },
