            "value": "Traditional Heritage"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn hóa truyền thống"
          }
        }
      }
    },
    "folkquote.source.co_ngu_phuong_dong": {
      "extractionState": "manual",
      "localizations": {
