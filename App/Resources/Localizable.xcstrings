            "value": "Ancient Eastern Saying"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cổ ngữ phương Đông"
          }
        }
      }
    },
    "folkquote.source.tam_tu_kinh": {
      "extractionState": "manual",
