require "base64"

default_platform(:ios)

platform :ios do
  before_all do
    ensure_bundle_exec
  end

  private_lane :setup_ci_keychain do
    if is_ci
      create_keychain(
        name: "ci_keychain",
        password: ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "ci_keychain_password",
        default_keychain: true,
        unlock: true,
        timeout: 3600,
        lock_when_sleeps: false
      )
    end
  end

  private_lane :app_store_connect_auth do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"] || (ENV["ASC_KEY_CONTENT_BASE64"] ? Base64.decode64(ENV["ASC_KEY_CONTENT_BASE64"]) : nil),
      is_key_content_base64: false,
      in_house: false
    )
  end

  # Production targets signed for App Store distribution: target name => bundle ID
  PROD_SIGNING_TARGETS = {
    "AnNien" => "com.iletai.annien",
    "AnNienWidget" => "com.iletai.annien.widget"
  }.freeze

  # Profile name installed by Match (falls back to Match's default naming)
  def match_profile_name(bundle_id)
    ENV["sigh_#{bundle_id}_appstore_profile-name"] || "match AppStore #{bundle_id}"
  end

  def signing_team_id
    ENV["APPLE_TEAM_ID"] || CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  end

  # Shared.xcconfig uses Automatic signing; switch each target to Manual with its Match profile
  private_lane :apply_manual_signing do
    PROD_SIGNING_TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        path: "AnNien.xcodeproj",
        use_automatic_signing: false,
        targets: [target],
        build_configurations: ["Release-Production"],
        team_id: signing_team_id,
        code_sign_identity: "Apple Distribution",
        profile_name: match_profile_name(bundle_id)
      )
    end
  end

  # Next build number: max(latest TestFlight + 1, GITHUB_RUN_NUMBER). TestFlight and App Store run as
  # separate workflows with separate run counters, so the TestFlight lookup keeps the number unique and monotonic.
  def resolve_build_number(api_key)
    [next_build_number(api_key), ENV["GITHUB_RUN_NUMBER"].to_i].max
  end

  # Marketing version comes from the release tag (v1.0.1 / release-1.0.1) so no manual bump is needed;
  # without a tag (e.g. workflow_dispatch) the value in Config/Shared.xcconfig is used.
  def marketing_version_xcarg
    version = ENV["RELEASE_VERSION"].to_s.sub(/\A(v|release-)/, "")
    version.match?(/\A\d+\.\d+\.\d+\z/) ? " MARKETING_VERSION=#{version}" : ""
  end

  def next_build_number(api_key)
    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: PROD_SIGNING_TARGETS["AnNien"],
      initial_build_number: 0
    ) + 1
  end

  def prod_export_options
    {
      method: "app-store",
      signingStyle: "manual",
      signingCertificate: "Apple Distribution",
      teamID: signing_team_id,
      provisioningProfiles: PROD_SIGNING_TARGETS.values.to_h { |id| [id, match_profile_name(id)] }
    }
  end

  desc "Run unit and integration tests"
  lane :test do
    scan(
      scheme: "AnNien-Dev",
      clean: true,
      code_coverage: true,
      output_directory: "fastlane/test_output",
      output_types: "html,junit",
      # Screenshot gallery runs in its own workflow (.github/workflows/ui-gallery.yml).
      skip_testing: "AnNienUITests/UIGalleryTests",
      fail_build: true
    )
  end

  desc "Sync certificates and provisioning profiles via Match"
  lane :sync_signing do |options|
    setup_ci_keychain
    api_key = app_store_connect_auth
    type = options[:type] || "appstore"
    readonly = options[:readonly].nil? ? is_ci : options[:readonly]

    match(
      app_identifier: PROD_SIGNING_TARGETS.values,
      type: type,
      readonly: readonly,
      keychain_name: is_ci ? "ci_keychain" : nil,
      keychain_password: is_ci ? (ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "ci_keychain_password") : nil,
      api_key: api_key
    )
  end

  desc "Build and upload beta build to TestFlight"
  lane :beta do |options|
    setup_ci_keychain
    api_key = app_store_connect_auth

    # Match code signing for Production App & Extensions
    match(
      app_identifier: PROD_SIGNING_TARGETS.values,
      type: "appstore",
      readonly: is_ci,
      keychain_name: is_ci ? "ci_keychain" : nil,
      keychain_password: is_ci ? (ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "ci_keychain_password") : nil,
      api_key: api_key
    )
    apply_manual_signing

    # Calculate incremented build number
    next_build = resolve_build_number(api_key)

    # Archive and export .ipa
    build_app(
      scheme: "AnNien-Prod",
      configuration: "Release-Production",
      export_method: "app-store",
      export_options: prod_export_options,
      clean: true,
      output_directory: "./build",
      output_name: "AnNien-Beta.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build}#{marketing_version_xcarg}"
    )

    # Distribute to TestFlight
    changelog_text = options[:changelog]
    if changelog_text.nil? && !is_ci
      changelog_text = prompt(text: "Changelog: ")
    end
    changelog_text ||= if ENV["RELEASE_NOTES_FILE"] && File.exist?(ENV["RELEASE_NOTES_FILE"])
      File.read(ENV["RELEASE_NOTES_FILE"]).strip
    else
      previous_tag = sh("git describe --tags --abbrev=0 HEAD^ 2>/dev/null || true", log: false).strip
      range = previous_tag.empty? ? "HEAD~20..HEAD" : "#{previous_tag}..HEAD"
      commits = sh("git log --pretty=format:'- %s' #{range} 2>/dev/null || true", log: false).strip
      commits.empty? ? "Pre-release build #{ENV['GITHUB_RUN_NUMBER'] || 'local'}" : commits
    end

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: changelog_text,
      distribute_external: false
    )
  end

  desc "Build and submit release to App Store Connect"
  lane :release do |options|
    setup_ci_keychain
    api_key = app_store_connect_auth

    match(
      app_identifier: PROD_SIGNING_TARGETS.values,
      type: "appstore",
      readonly: is_ci,
      keychain_name: is_ci ? "ci_keychain" : nil,
      keychain_password: is_ci ? (ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "ci_keychain_password") : nil,
      api_key: api_key
    )
    apply_manual_signing

    build_app(
      scheme: "AnNien-Prod",
      configuration: "Release-Production",
      export_method: "app-store",
      export_options: prod_export_options,
      clean: true,
      output_directory: "./build",
      output_name: "AnNien-Release.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{resolve_build_number(api_key)}#{marketing_version_xcarg}"
    )

    app_review_info = {
      first_name: ENV.fetch("APP_REVIEW_FIRST_NAME"),
      last_name: ENV.fetch("APP_REVIEW_LAST_NAME"),
      phone_number: ENV.fetch("APP_REVIEW_PHONE"),
      email_address: ENV.fetch("APP_REVIEW_EMAIL"),
      notes: "App tra cứu Lịch Âm Dương và Quản lý Ngày Nhớ. Ứng dụng không yêu cầu đăng nhập tài khoản."
    }

    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_screenshots: true,
      skip_metadata: ENV['SKIP_METADATA'] == 'true',
      app_review_information: app_review_info,
      # Source of truth for age rating; AdMob requires "advertising": true (Guideline 2.3.6)
      app_rating_config_path: "fastlane/app_rating_config.json",
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submit_for_review: options[:submit_for_review] || false,
      automatic_release: options[:automatic_release] || false
    )
  end

  desc "Upload screenshots to App Store Connect (retry safe)"
  lane :upload_screenshots do
    api_key = app_store_connect_auth
    begin
      upload_to_app_store(
        api_key: api_key,
        app_identifier: PROD_SIGNING_TARGETS["AnNien"],
        skip_binary_upload: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        skip_metadata: true,
        force: true
      )
    rescue StandardError => e
      UI.message("First attempt failed (#{e.message}), retrying after 10s...")
      sleep(10)
      upload_to_app_store(
        api_key: api_key,
        app_identifier: PROD_SIGNING_TARGETS["AnNien"],
        skip_binary_upload: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        skip_metadata: true,
        force: true
      )
    end
  end

  desc "Capture real screenshots from simulator only (no ASC credentials needed)"
  lane :capture_screenshots_only do
    capture_screenshots
  end

  desc "Capture real screenshots from simulator, then upload to App Store Connect"
  lane :screenshots do
    capture_screenshots

    api_key = app_store_connect_auth
    upload_to_app_store(
      api_key: api_key,
      app_identifier: PROD_SIGNING_TARGETS["AnNien"],
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      skip_metadata: true,
      force: true
    )
  end
end
