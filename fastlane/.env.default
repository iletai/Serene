# Non-secret app config, committed. fastlane loads this file automatically.
# Lanes live in https://github.com/iletai/ios-shared (fastlane/Fastfile).
APP_IDENTIFIER=com.iletai.annien
EXTRA_APP_IDENTIFIERS=com.iletai.annien.widget
XCODE_PROJECT=AnNien.xcodeproj
SCHEME=AnNien-Prod
TEST_SCHEME=AnNien-Dev
BUILD_CONFIGURATION=Release-Production
# Screenshot gallery runs in its own workflow (.github/workflows/ui-gallery.yml).
SCAN_SKIP_TESTING=AnNienUITests/UIGalleryTests
SCAN_CLEAN=true
RELEASE_NOTES_FILE=fastlane/metadata/vi/release_notes.txt
# Source of truth for age rating; AdMob requires "advertising": true (Guideline 2.3.6).
APP_RATING_CONFIG_PATH=fastlane/app_rating_config.json
APP_REVIEW_NOTES="App tra cứu Lịch Âm Dương và Quản lý Ngày Nhớ. Ứng dụng không yêu cầu đăng nhập tài khoản."
